+        expect(read(), 'a remount of the same turn keeps its age').toMatch(/for 40s/);
+        again.unmount();
+        // Control: with no start handed in, the row falls back to its mount —
+        // which is exactly the reading that used to be the only one there was.
+        render(<AnalyzedRow running><p>timeline</p></AnalyzedRow>);
